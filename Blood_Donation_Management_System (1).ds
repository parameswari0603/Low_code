 application "Blood Donation Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form blood_distribution
		{
			displayname = "Blood Distribution"
			success message = "Blood Distribution Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			issue_date
			(
    			type = date
				displayname = "Issue Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			delivery_method
			(
				type = picklist
				displayname = "Delivery Method"
				values = {"Pickup","Handover","Delivery"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			distribution_status
			(
				type = picklist
				displayname = "Distribution Status"
				values = {"Returned","Delivered","Issued"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			issued_units
			(
				type = number
				displayname = "Issued Units"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			delivery_person
			(
    			type = name
				displayname = "Delivery Person"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_1
			(
				type = list	
				displayname = "Request"
				values  = blood_request.ID
    			displayformat = [request_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			distribution_id
			(
    			type = autonumber
				displayname = "Distribution Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issued_Blood_Units
			(
				type = grid
				displayname = "Issued Blood Units"
				Inventory_Unit
				(
					type = picklist	
					displayname = " Inventory Unit"
					values  = blood_inventory.ID
    				displayformat = [blood_group]
					sortorder = ascending
					width = medium
				)
				Blood_Group
				(
					type = picklist
					displayname = "Blood Group"
					maxchar = 100
					values = {"A+","A-","B+","B-","AB+","AB_","O+","O-"}
					width = medium
				)
				Component_Type
				(
					type = picklist
					displayname = "Component Type"
					maxchar = 100
					values = {"Whole Blood","Platelets","Plasma"}
					width = medium
				)
				Quantity_Issued
				(
					type = number
					displayname = "Quantity Issued"
					width = medium
				)
				Expiry_Date
				(
    				type = date
					displayname = "Expiry Date"
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
