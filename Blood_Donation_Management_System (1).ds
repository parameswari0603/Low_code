tion'\n\t\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'right.center'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'blood_inventory'\n\txfield = 'component_type'\n\tyfields = 'sum:quantity'\n\tshowDataLabel = 'true'\n\t\tDelugeCriteria = 'blood_group == &quot;AB-&quot; &amp;&amp; availability_status == &quot;Available&quot; &amp;&amp; expiry_date &gt; zoho.currentdate'\n/>\n\n</column>\n</row>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 11'\n\n\t\n\ttitle = 'O+ Blood Distribution'\n\t\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'right.center'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'blood_inventory'\n\txfield = 'component_type'\n\tyfields = 'sum:quantity'\n\tshowDataLabel = 'true'\n\t\tDelugeCriteria = 'blood_group == &quot;O+&quot; &amp;&amp; availability_status == &quot;Available&quot; &amp;&amp; expiry_date &gt; zoho.currentdate'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 12'\n\n\t\n\ttitle = 'O- Blood Distribution'\n\t\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'right.center'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'blood_inventory'\n\txfield = 'component_type'\n\tyfields = 'sum:quantity'\n\tshowDataLabel = 'true'\n\t\tDelugeCriteria = 'blood_group == &quot;O-&quot; &amp;&amp; availability_status == &quot;Available&quot; &amp;&amp; expiry_date &gt; zoho.currentdate'\n/>\n\n</column>\n</row>\n</column>\n</row>\n</layout>\n</zml>"
