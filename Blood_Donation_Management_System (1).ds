	reports
	{
		list blood_donation_record_Report
		{
			displayName = "All Blood Donation Records"
			show all rows from blood_donation_record    
			(
				donation_date as "Donation Date"
				donation_type as "Donation Type"
				collection_time as "Collection Time"
				collection_location as "Collection Location"
				donor as "Donor"
				camp as "Camp"
				screening as "Screening"
				record_id as "Record Id"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (donation_type == "Plasma")
				fields = [donation_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (donation_type == "Platelets")
				fields = [donation_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (donation_type == "Whole Blood")
				fields = [donation_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban blood_donation_record_by_donation_type
		{
			displayName = "Donation Types"
			show all rows from blood_donation_record    
			(
				donation_date as "Donation Date"
				donation_type as "Donation Type"
				collection_time as "Collection Time"
				collection_location as "Collection Location"
				donor as "Donor"
				camp as "Camp"
				screening as "Screening"
				record_id as "Record Id"
			)
			filters
			(
				camp
				screening
			)
			sort by
			(
				collection_time ascending
			)
			options
			(
	 			display field = donation_type
	 		)
		}
