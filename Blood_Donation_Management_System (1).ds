		workflow
		{
		form
		{
			cancel_ineligible_registration as "Cancel Registration if Ineligible"
			{
				type =  form
				form = donor_registration

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if donor has reached minimum age (18 years)
										if(input.date_of_birth != null)
										{
											currentYear = zoho.currentdate.getYear();
											birthYear = input.date_of_birth.getYear();
											age = currentYear - birthYear;
											if(age < 18)
											{
												alert "Donor must be at least 18 years old to register.";
												cancel submit;
											}
										}
										// Check if blood group is selected
										if(input.blood_group.isBlank())
										{
											alert "Please select a blood group.";
											cancel submit;
										}
										// Check if consent is given
										if(input.consent_given == false)
										{
											alert "Donor consent is required for registration.";
											cancel submit;
										}
						)
					}
				}

			}
			Blood_Inventory_workFlow as "Blood Inventory workFlow"
			{
				type =  form
				form = blood_inventory

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate that expiry_date is not in the past when blood_inventory form is validated
										if(!input.expiry_date.isNull())
										{
											if(input.expiry_date < zoho.currentdate)
											{
												alert "Expiry date cannot be in the past. Please enter a valid future date.";
											}
										}
										// Validate that quantity is a positive number
										if(!input.quantity.isNull())
										{
											if(input.quantity <= 0)
											{
												alert "Quantity must be greater than zero.";
											}
										}
										// Validate that storage_location is not empty
										if(input.storage_location.isBlank())
										{
											alert "Storage location is required.";
										}
						)
					}
				}

			}
			Donor_Screening_workFlow as "Donor Screening workFlow"
			{
				type =  form
				form = donor_screening

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate hemoglobin level is not blank
										if(input.hemoglobin_level.isNull())
										{
											alert(hemoglobin_level,"Hemoglobin level is required");
										}
										// Validate hemoglobin level is a valid number (greater than 0)
										if(!input.hemoglobin_level.isNull())
										{
											if(input.hemoglobin_level <= 0)
											{
												alert(hemoglobin_level,"Hemoglobin level must be greater than 0");
											}
										}
										// Validate pulse rate is not blank
										if(input.pulse_rate.isNull())
										{
											alert(pulse_rate,"Pulse rate is required");
										}
										// Validate pulse rate is a valid number (between 50 and 100 for adults)
										if(!input.pulse_rate.isNull())
										{
											if(input.pulse_rate < 50 || input.pulse_rate > 100)
											{
												alert(pulse_rate,"Pulse rate should be between 50 and 100");
											}
										}
										// Validate temperature is not blank
										if(input.temperature.isNull())
										{
											alert(temperature,"Temperature is required");
										}
										// Validate temperature is a valid number (between 36 and 37.5 degrees Celsius)
										if(!input.temperature.isNull())
										{
											if(input.temperature < 36 || input.temperature > 37.5)
											{
												alert(temperature,"Temperature should be between 36 and 37.5 degrees Celsius");
											}
										}
										// Validate blood pressure is not blank
										if(input.blood_pressure.isNull())
										{
											alert(blood_pressure,"Blood pressure is required");
										}
										// Set default screening result if not provided
										if(input.screening_result.isNull())
										{
											input.screening_result = "Pending";
										}
						)
					}
				}

			}
			Blood_Donation_Record as "Blood Donation Record"
			{
				type =  form
				form = blood_donation_record

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if donor is selected
										if(input.donor.isNull())
										{
											alert "Please select a donor.";
											cancel submit;
										}
										// Check if screening record is selected
										if(input.screening.isNull())
										{
											alert "Please select the donor screening record.";
											cancel submit;
										}
										// Check if donation date is not in the future
										if(input.donation_date > zoho.currentdate)
										{
											alert "Donation date cannot be in the future.";
											cancel submit;
										}
										// Check if collection time is valid (not in the future if donation date is today)
										if(input.donation_date == zoho.currentdate && input.collection_time > zoho.currenttime)
										{
											alert "Collection time cannot be in the future for today's date.";
											cancel submit;
										}
										// Verify donor and screening records match
										if(!input.donor.isNull() && !input.screening.isNull())
										{
											donorRecord = donor_registration[ID == input.donor];
											screeningRecord = donor_screening[ID == input.screening];
											if(donorRecord.ID != screeningRecord.donor.ID)
											{
												alert "The selected donor and screening record do not match.";
												cancel submit;
											}
											// Check if screening result is Pass
											if(screeningRecord.screening_result != "Pass")
											{
												alert "Donor screening result must be Pass to proceed with donation.";
												cancel submit;
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			expiry_alert_inventory as "Expiry Alert for Blood Inventory"
			{
				type =  schedule
				form = blood_inventory
					status = inactive
				start = expiry_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch blood inventory records expiring within 7 days
										expiringUnits = blood_inventory[expiry_date in next 7 days];
										// Iterate through each expiring unit and send notification
										for each  unit in expiringUnits
										{
											// Check if expiry_date is valid
											if(unit.expiry_date.isNull())
											{
												continue;
											}
											// Calculate days remaining
											daysRemaining = unit.expiry_date.daysBetween(today);
											// Prepare notification message
											message = "<p>Dear Staff,</p>";
											message = message.concat("<p>This is a reminder that the following blood unit is expiring within 7 days:</p>");
											message = message.concat("<ul>");
											message = message.concat("<li><strong>Blood Group:</strong> " + unit.blood_group + "</li>");
											message = message.concat("<li><strong>Component Type:</strong> " + unit.component_type + "</li>");
											message = message.concat("<li><strong>Quantity:</strong> " + unit.quantity.toString() + "</li>");
											message = message.concat("<li><strong>Expiry Date:</strong> " + unit.expiry_date.toString("dd-MMM-yyyy") + "</li>");
											message = message.concat("<li><strong>Storage Location:</strong> " + unit.storage_location + "</li>");
											message = message.concat("<li><strong>Days Remaining:</strong> " + daysRemaining.toString() + "</li>");
											message = message.concat("</ul>");
											message = message.concat("<p>Please take necessary action to manage this unit before expiry.</p>");
											// Send notification email
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.loginuserid
												subject :"Blood Unit Expiry Alert - " + unit.blood_group + " - " + unit.component_type
												message :message
												content type :HTML
											]
										}
					)
					}
				}
			}
		}


		blueprint
